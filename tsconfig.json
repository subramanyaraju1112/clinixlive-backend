{
  "compilerOptions": {
    /* Environment */
    "target": "ES2020",
    "lib": ["ES2020"],

    /* Module system */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* Project structure */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Type safety */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Interop */
    "esModuleInterop": true,

    /* Node globals */
    "types": ["node"],

    /* Build */
    "sourceMap": true,
    "skipLibCheck": true,

    /* Required for ESM */
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
